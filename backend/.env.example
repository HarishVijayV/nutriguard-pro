# Copy to .env and fill in. Used by both local runs and docker compose.
TAVILY_API_KEY=

# ── Provider chain, tried top to bottom ───────────────────────────
# 1. Gemini (at least one key is REQUIRED — the app refuses to boot without it)
GOOGLE_API_KEY_1=
GOOGLE_API_KEY_2=
# 2. Groq — optional, skipped if empty
GROQ_API_KEY=
# 3. OpenRouter — optional, skipped if empty
OPENROUTER_API_KEY=
# 4. Fireworks — optional; the LAST real LLM before the offline clinical template.
#    Needs BOTH vars. Comma-separate FIREWORKS_MODEL to try several in order.
FIREWORKS_API_KEY=
FIREWORKS_MODEL=accounts/fireworks/models/deepseek-v4-flash
# FIREWORKS_MAX_TOKENS=8192
# FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1/chat/completions

MODEL_PATH=./nutriguard_embedding_model
CHROMA_PATH=./chroma_db

# SKIP_HEALTH_PROBE=0
